          <Data name="en_name">
            <value>Temple of Jupiter Dolichenus</value>
          </Data>
          <Data name="popupinfo">
            <value>معبد جوبيتير دوليكينوس في لبدة الكبرى، يقع بالقرب من الميناء السيفيري</value>
          </Data>
          <Data name="type">
            <value>Roman Temple / Dolichenum</value>
          </Data>
          <Data name="Description_EN">
            <value>The Temple of Jupiter Dolichenus is a Roman sanctuary at ancient Lepcis Magna, located near the Severan harbour. Archaeological and epigraphic evidence connects the monument with the worship of Jupiter Dolichenus and with the religious landscape of the Roman port city.</value>
          </Data>
          <Data name="Description_AR">
            <value>معبد جوبيتير دوليكينوس هو معبد روماني في مدينة لبدة الكبرى القديمة، يقع بالقرب من الميناء السيفيري. وترتبط به أدلة أثرية ونقوشية تؤكد ارتباط الموقع بعبادة جوبيتير دوليكينوس وبالمشهد الديني للمدينة الرومانية ومينائها.</value>
