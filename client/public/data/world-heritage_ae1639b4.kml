          <Data name="region_المنطقة">
            <value>الساحل الغربي </value>
          </Data>
          <Data name="الوصف">
            <value>السوق الرومانية في لبدة الكبرى هي أحد أقدم المراكز التجارية في المدينة، شُيدت خلال الفترة الرومانية وكانت مخصصة للنشاط التجاري وتبادل السلع. تتميز بتخطيطها المعماري الفريد، حيث تضم ساحتين دائريتين محاطتين بالأعمدة ومباني مخصصة للبيع والعرض، وتعكس ازدهار الحياة الاقتصادية في المدينة.</value>
          </Data>
          <Data name="en_name">
            <value>Romanian Market‏‏‏</value>
          </Data>
          <Data name="popupinfo">
            <value>مركز تجاري روماني تاريخي في لبدة الكبرى، يتميز بساحاته الدائرية والأعمدة الرخامية، ويُعد من أقدم الأسواق الرومانية المحفوظة في شمال أفريقيا.</value>
          </Data>
          <Data name="type">
            <value>Cultural Heritage‏‏</value>
          </Data>
          <Data name="Description_EN">
            <value>The Roman Market of Leptis Magna is one of the oldest commercial centers in the city. Built during the Roman period, it was used for trading activities and displaying goods. The market is distinguished by its unique design, including two circular courtyards surrounded by columns and commercial spaces.‏‏</value>
          </Data>
          <Data name="Description_AR">
            <value>يعد السوق الروماني من أقدم المراكز التجارية في لبدة الكبرى، وقد كان مركزاً للنشاط الاقتصادي خلال العصر الروماني، ويتميز بتصميمه المعماري الفريد وساحاته الدائرية المحاطة بالأعمدة.</value>
          </Data>
