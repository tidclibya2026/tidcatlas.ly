          <Data name="en_name">
            <value>Temple of the Severan Family‏</value>
          </Data>
          <Data name="popupinfo">
            <value>العصر الروماني – الأسرة السيفيرية</value>
          </Data>
          <Data name="type">
            <value>Roman Temple‏</value>
          </Data>
          <Data name="Description_EN">
            <value>The Temple of the Severan Family is an archaeological monument associated with the prosperous Severan period of Leptis Magna during the 3rd century AD, reflecting the imperial character of the city and its connection with Emperor Septimius Severus.
‏</value>
          </Data>
          <Data name="Description_AR">
            <value>معبد العائلة السيفيرية أحد المعالم الأثرية المرتبطة بفترة ازدهار مدينة لبدة الكبرى خلال حكم الأسرة السيفيرية في القرن الثالث الميلادي، ويعكس الطابع الإمبراطوري للمدينة التي كانت مسقط رأس الإمبراطور سبتيميوس سيفيروس.
</value>
          </Data>
