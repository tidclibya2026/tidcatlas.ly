            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3AAjQbR6Tzis5WPApqM5D1ngVQ0Pl4e43tBAAak0fjKquG3GjGfwEdCFKpDRlJ34zo9Bq5cL2ocrY08Hreia99i0qCQX46YjWnoArQPbB5e4uLez9ZUiBUgY4Exd24dt_7KiVLaYAgCEP-dkfx1pPAJZPUJaaiBhChM4gAKf4AxA4UuyJ9GCNU47i_fQMrPZ191bqfFKL5_tYu23jSjiA9Z4A9FKKpcTyaG0kh8N1UKQzvpUtXozqV6eSNjlQMwY?authuser=1&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3AAjQbR6HV1_lrZ1Lay86FsK_oKgxxuOYvw4y8z-YlcnFhCRUrJgqVke2HSX_cH0dphkSWJFoSpFtpjgyluqBsdy2y-dFPRy5waHRsQHXxBvr1EXgmpAHPmRkD3ECkYGTQvJuTq20LD0pT63mOGrk8xr7lIjQ4MSWSnQL99r-jg-M_W-vv3nFlekJoaiXnmIXw3G5YeNzaOMJwcrzdwmj4LdzTPQShMazzh9gSUX0-ng6SQpWG6_1aKzVvGbqv1Q?authuser=1&fife=s16383]]></value>
