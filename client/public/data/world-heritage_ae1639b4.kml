            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3AAjQbR4HJULybO7CwF4SLHTc7ricLjEaqLhQs4ET7SFaAFf0_2gZC4w4EjI_9fJeV00_Sl5cxnYQs3T0dmXVZ9uf5xDuF80i2i-E2YcNLI9qA8myN3HKQPBS9XOGqCOms45Z4jWNfSe4YfVm_m3wjmd95hLuUiQaMEl1xcXMIioaaQ_kuTg4NlmuRhDtBBVl2M5VsZCgnN3ri3lddUT_9InbLLzNt7Wc-CXCXodcEkGdaOLO6XOdPFFDJ4yTTL8?authuser=1&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3AAjQbR5INBca-9YcPStZs47A6po9lD_lSfqlx7pACz5ZnFcV0FXjnf5AMQbnWM6QHHCk0xiqHKCn2zubF38dDamGdkLZFFEpnn1fHNizcf0TC3Py8uSWb3cuGYaMQyL12aNu3808D4x6zgeI5MytObYQTJVK0jAllms9wBrqd0dRMB-Aw4nT717AY9qbVivFF-VCVi7VMb2h3foHovASMJtSkaaSuHRf4Nnza91vkLRkKfxglhM4x81j0Gb7jI0?authuser=1&fife=s16383]]></value>
