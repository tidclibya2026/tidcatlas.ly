            <value/>
          </Data>
          <Data name="en_name">
            <value>leptis Magna Museum</value>
          </Data>
          <Data name="popupinfo">
            <value>متحف لبدة الأثري، وهو متحف مخصص لعرض اللقى والآثار المكتشفة في مدينة لبدة الكبرى ومحيطها</value>
          </Data>
          <Data name="type">
            <value>Archaeological Museum</value>
          </Data>
          <Data name="Description_EN">
            <value>The Leptis Magna Museum is an archaeological museum in Khoms, Libya, associated with the ancient city of Leptis Magna. Its collections document the cultural history of the city and include archaeological material representing the different peoples and cultures that inhabited Leptis Magna, including Phoenician, Punic, Roman and later remains.</value>
          </Data>
          <Data name="Description_AR">
            <value>متحف لبدة الأثري هو متحف أثري في مدينة الخمس بليبيا، يرتبط بمدينة لبدة الكبرى القديمة. وتوثق مجموعاته التاريخ الثقافي للمدينة وتضم مواد أثرية تمثل الشعوب والثقافات التي عاشت في لبدة الكبرى، بما في ذلك الآثار الفينيقية والبونية والرومانية والآثار اللاحقة.</value>
          </Data>
          <Data name="الفترة التاريخية">
            <value>مقتنيات من فترات متعددة، أبرزها العصر الروماني؛ المتحف نفسه حديث</value>
          </Data>
