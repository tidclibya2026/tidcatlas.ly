          <Data name="ERA_الحقبة التاريخية">
            <value>فينيقية – رومانية – بيزنطية</value>
          </Data>
          <Data name="Accessibility">
            <value>سهل الوصول (عبر الطريق الساحلي، تتوفر مواقف للسيارات ومسارات للزوار وفق حالة الموقع)</value>
          </Data>
          <Data name="Tourism_Level">
            <value>عالمي</value>
          </Data>
          <Data name="الفئة">
            <value>تراث ثقافي</value>
          </Data>
          <Data name="Description_AR">
            <value>مدينة رومانية أثرية ساحلية تُعد من أبرز مواقع التراث العالمي في ليبيا، وتشتهر بمسرحها الروماني ومعالمها المعمارية الفريدة.</value>
          </Data>
          <Data name="Description_EN">
            <value><![CDATA[Sabratha is one of Libya's most important archaeological cities and a UNESCO World Heritage Site. Originally founded as a Phoenician trading post, it flourished under Carthaginian and Roman rule. The site is famous for its magnificent Roman theater overlooking the Mediterranean, along with temples, baths, forums, and other monumental structures.
‏‏]]></value>
          </Data>
          <Data name="الوصف">
            <value>موقع صبراتة الأثري 
 مدينة أثرية تعود أصولها إلى العصر الفينيقي وازدهرت خلال العصر الروماني، وتضم المسرح الروماني، والفوروم، والمعابد، والحمامات، والميناء القديم، والفسيفساء. تُعد من أهم المواقع الأثرية في ليبيا، وأُدرجت على قائمة التراث العالمي لليونسكو عام 1982.
name موقع صبراتة الأثري 
ثقافي 
كانت تعتبر صبراتة مركز تجاري فينيقي لمرور منتجات أفريقيا الداخلية، كما أنها شكلت جزءًا من المملكة النوميدية الزائلة في ماسّينيسّا قبل أن ت
</value>
          </Data>
          <Data name="ملاحظة">
            <value/>
          </Data>
          <Data name="الاهمية التاريخية">
            <value>تُعد صبراتة إحدى المدن الثلاث الرئيسية في إقليم طرابلس القديم (تريبوليس)، وكانت مركزًا تجاريًا مهمًا يربط شمال أفريقيا بعمق الصحراء. وقد أُدرجت ضمن قائمة التراث العالمي لليونسكو لما تتمتع به من قيمة تاريخية ومعمارية استثنائية.
</value>
          </Data>
          <Data name="الانشطة السياحية">
            <value>الجولات الأثرية برفقة مرشدين.التصوير الفوتوغرافي.زيارة المتحف الأثري.استكشاف المسرح الروماني والمعابد.مشاهدة غروب الشمس على الساحل والموقع الأثري.السياحة التعليمية والثقافية.تنظيم الرحلات المدرسية والجامعية.
</value>
          </Data>
          <Data name="امكانية الوصول">
            <value>يقع الموقع في مدينة صبراتة على الساحل الغربي الليبي، على بعد حوالي 70 كم غرب طرابلس، ويمكن الوصول إليه بسهولة عبر الطريق الساحلي.</value>
          </Data>
