        <ExtendedData>
          <Data name="المدينة">
            <value>لبدة الكبرى</value>
          </Data>
          <Data name="التصنيف">
            <value>اثري</value>
          </Data>
          <Data name="Subcategory_التصنيف الفرعي">
            <value>سوق رومانية</value>
          </Data>
          <Data name="MUNICIPALITY">
