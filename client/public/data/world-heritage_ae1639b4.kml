          <Data name="en_name">
            <value>Eastern Baths</value>
          </Data>
          <Data name="popupinfo">
            <value>الحمامات الشرقية في مدينة لبدة الكبرى، وتقع بالقرب من الميناء والطريق الساحلي القديم</value>
          </Data>
          <Data name="type">
            <value>Roman Baths</value>
          </Data>
          <Data name="Description_EN">
            <value>The Eastern Baths are a Roman bath complex at ancient Lepcis Magna, located close to the harbour and the ancient coastal road. Archaeological excavations have documented the complex and its use during the Roman and Late Antique periods.</value>
          </Data>
          <Data name="Description_AR">
            <value>الحمامات الشرقية هي مجمع حمامات روماني في مدينة لبدة الكبرى القديمة، يقع بالقرب من الميناء والطريق الساحلي القديم. وقد وثقت الحفريات الأثرية المجمع واستخدامه خلال العصر الروماني والعصور المتأخرة.</value>
          </Data>
          <Data name="الفترة التاريخية">
            <value>العصر الروماني المتأخر والعصور القديمة المتأخرة؛ منتصف القرن الثالث–نهاية القرن الرابع الميلادي</value>
          </Data>
