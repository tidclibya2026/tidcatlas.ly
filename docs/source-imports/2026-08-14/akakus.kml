            <value><![CDATA[https://mymaps.usercontent.google.com/hostedimage/m/*/3AAjQbR77mC_a-8RDO9CY6wQQr6VU4pSdmuAtXHpZM921FOeq_w1g7mBW5NfZJ8ppimsOCFd-zhVMsQBfyGXH3P6uH67u8yObLnWvv4WJDnUr2Qe_CnTDIrGiUaaO7VLu1oYCXofTVyFQede3Zhw5z6l7qeYIjC-FItZsYlODMgM9RwZuQJocVmBJf-pq3yA4asZOVC6QNbHPKq8UR8Toh4M4aq06ZuBuD_cj_4TgN0L2oGeP2gXL9cLhXS1W0IU?authuser=1&fife=s16383 https://mymaps.usercontent.google.com/hostedimage/m/*/3AAjQbR4-tkeVcT7M80_m8lJmyq7rZI1zKHjaZvfwUq15bYqp21BpFpTMvpunyxKPxzIF0f_wkwjO-9g19j1kcWk_BrhPE36V-QYxmgpP9FF469UbrampIhAcMkq2clgTPfxBiKqE3NLKIq5puCHzOj1-2SJcazH2JjKRAAL8uj_cN_IN-7nLS9I_njCifRl6OkmWxK0ckpdsJqrJ9Z4KX7gR9WmOk4Qlr0SeyNt0DUDAel1o-esvD9bMG1ys2x8?authuser=1&fife=s16383]]></value>
