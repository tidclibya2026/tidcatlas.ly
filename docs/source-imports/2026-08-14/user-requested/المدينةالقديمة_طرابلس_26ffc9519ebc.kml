        <ExtendedData>
          <Data name="الوصف">
            <value>جامع الناقة‎</value>
          </Data>
          <Data name="En">
            <value>Al-Naqa Mosque</value>
          </Data>
          <Data name="العنوان">
            <value>طرابلس/المدينة القديمة‎‎</value>
          </Data>
          <Data name="النوع">
            <value>جامع</value>
          </Data>
          <Data name="معلومات اخرى">
            <value>أقدم الجوامع في طرابلس ، يقع في طرابلس ، يقع في منطقة الفنيدقة ، وينسب بناؤه إلي المعز لدين الله الفاطمي ، القاهرة ، الأول الرابع الهجري
أيام والي طرابلس صفر داي ، كما رمم الجامع مرة ثانية بعد الحرب العالمية الثانية ، بسبب الخراب الذي لحق به جراء القصفعند احتلالهم لمدينة ويمتاز الجامع بطرازه الليبي القديم ، ذي القباب الصغير الذي انتشر في انحاء ليبيا في فترة ما بين القرن السادس عشر ومنتصف القرن التاسع عشرطرابلس وبقى نحو قرن من الزمان في حالة خراب حتى أعيد بناؤه بتاريخ 26 مارس 1610 م القرن العاشر الميلادي ، وقد دمره ، سنه 1510 م‎</value>
          </Data>
