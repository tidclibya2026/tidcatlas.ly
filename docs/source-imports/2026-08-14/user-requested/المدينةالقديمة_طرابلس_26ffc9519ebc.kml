            <value>طرابلس/المدينة القديمة‎‎‎</value>
          </Data>
          <Data name="النوع">
            <value>قنصلية</value>
          </Data>
          <Data name="معلومات اخرى">
            <value><![CDATA["يعود تاريخ بناء المبنى إلى العهد القره مانلي (1711 - 1835م)، ويقع في شارع (الأربع عرصات) المؤدي إلى ميدان السيدة مريم. وقد استُخدم هذا المبنى مقراً للقنصلية الإيطالية في فترة حكم يوسف باشا القره مانلي (1795 - 1832م)، واستمر يؤدي هذا الدور حتى نهاية العهد العثماني الثاني (1835 - 1911م)."]]></value>
          </Data>
        </ExtendedData>
