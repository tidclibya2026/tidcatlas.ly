        <styleUrl>#icon-seq2-0-5-E65100-labelson</styleUrl>
        <ExtendedData>
          <Data name="الاسم باللغة الانجليزية">
            <value>Al Manara Tourist Hotel</value>
          </Data>
          <Data name="description">
            <value>يقع الفندق بالقرب من موقع مدينة سوسة الأثري، وبإطلالة على البحر وتلال الجبل الأخضر، ويعتبر مرفق الإيواء السياحي الوحيد بالمدينة، ويتألف من ستة طوابق.‎‎‎‎‎‎‎‎</value>
          </Data>
          <Data name="x">
            <value>32.90075</value>
          </Data>
          <Data name="Y">
            <value>21.96474</value>
          </Data>
          <Data name="العنوان">
            <value>سوسة‎‎‎‎‎‎‎‎</value>
          </Data>
          <Data name="الاتصال">
            <value>0695153003 </value>
          </Data>
          <Data name="نطاق الأسعار">
            <value>150 إلى 300 دينار ليبي‎</value>
          </Data>
          <Data name="التصنيف">
            <value>4نجوم</value>
          </Data>
          <Data name="عدد الغرف">
            <value>يحتوي الفندق على 78 غرفة، 30 غرفة فردية، 30 غرفة زوجية، 6 غرف ثلاثية، 6 غرف سرير حجم كبير، 11 جناح ممتاز، 11 جناح عادي‎‎‎‎‎‎‎‎</value>
          </Data>
          <Data name="الخدمات">
            <value>يوفر الفندق خدمات الطعام عبر مطعم سوسة البالغة قدرته الاستيعابية 120 شخص، ومقهى أبوللو الذي يتسع لـ 30 شخصاً، كما زود الفندق بموقف خاص للسيارات ستوعب 55 سيارة.‎‎‎‎‎‎‎‎</value>
          </Data>
          <Data name="الوصف">
            <value>أحد أبرز الفنادق المطلة على الساحل في منطقة الجبل الأخضر بليبيا‎</value>
          </Data>
          <Data name="وسائل الاتصال">
