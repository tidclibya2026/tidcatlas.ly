            <value>32.65519</value>
          </Data>
          <Data name="العنوان">
            <value>يقع في شارع الشط، وسط المدينة (بالقرب من منطقة المنتزه).الخمس، ليبيا.</value>
          </Data>
          <Data name="الاتصال">
            <value>‏093-1331242‏-218910595564+.‎‎‎</value>
          </Data>
          <Data name="نطاق الأسعار">
            <value>تبدأ من 80 إلى 130 دينار ليبي لليلة الواحدة.</value>
          </Data>
          <Data name="التصنيف">
            <value>3 نجوم من قبل الزوار</value>
          </Data>
          <Data name="عدد الغرف">
            <value/>
          </Data>
          <Data name="الخدمات">
            <value>يتم العمل حالياً على تجهيز وإضافة شقق مفروشة بالكامل لتوسيع خيارات الإقامة الطويلة.</value>
          </Data>
          <Data name="الوصف">
            <value>هو خيار إقامة يقع في مدينة الخمس، ويتميز بتقديم خدمات مريحة للمسافرين ورجال الأعمال.‎‎‎</value>
