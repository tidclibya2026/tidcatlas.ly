          </Data>
          <Data name="العنوان">
            <value>يقع على يمين الطريق المؤدي غرباً للادارة العامة لجامعة عمر المختاربجوار السكن الجامعي، 
‏البيضاء ليبيا‎‎‎‎‎‎‎‎‎‎</value>
          </Data>
          <Data name="الاتصال">
            <value>لا توجد ارقاكم هواتف مباشرة يفل التوجه لعين المكان</value>
          </Data>
          <Data name="نطاق الأسعار">
            <value>من 100 الى 450 دينار ليبي</value>
          </Data>
          <Data name="التصنيف">
            <value>3 نجوم</value>
          </Data>
          <Data name="عدد الغرف">
            <value>يحتوي الفندق على (18) غرفة بين فردية وزوجية وثلاثية بالإضافة إلى أربعة أجنحة ممتازة، ‎‎‎</value>
          </Data>
          <Data name="الخدمات">
            <value>في مكان هادئ وآمن ومزود بمواقف شاسعة  للسيارات بعيدا عن ضجيج المدينة ل فندق مزود بمطعم مميز يستوعب من 100- 150 شخص.
باحة الفندق تحتوي على جلسات هادئة ومزودة بخدمات انترنت ومقهى يقدم المشروبات الساخنة والباردة لنزلاء الفندق وزواره..  ‎‎‎</value>
          </Data>
          <Data name="الوصف">
            <value>فندق بلاغراي السياحي
فندق بلاغراي السياحي مملوك لجامعة عمر المختار و تديره شركة مباني القابضة، يقع الفندق في مدينة البيضاء‎</value>
          </Data>
          <Data name="وسائل الاتصال">
            <value>لا يمتلك فندق بلاغراي السياحي صفحة رسمية مستقلة خاصة به على منصة فيسبوك </value>
          </Data>
          <Data name="الفئة">
            <value/>
          </Data>
