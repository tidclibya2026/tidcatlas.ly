          <Data name="الاسم باللغة الانجليزية">
            <value>Al-Fardous Hotel Apartments</value>
          </Data>
          <Data name="description">
            <value>يتميز المكان بكونه يجمع بين خصوصية المنزل وخدمات الفندق، حيث يوفر شققاً مفروشة بالكامل (تتضمن مطبخاً، ثلاجة، وغسالة) وبأثاث عصري ونظيف. هو خيار مفضل للعائلات أو المسافرين الباحثين عن الهدوء والاستقلالية في قلب الجبل الأخضر.</value>
          </Data>
          <Data name="x">
            <value>21.747581</value>
          </Data>
          <Data name="Y">
            <value>32.764217</value>
          </Data>
          <Data name="العنوان">
            <value>مدينة البيضاء / شارع العروبة خلف مصرف الوحدة.</value>
          </Data>
          <Data name="الاتصال">
            <value>‏092-6743130‏
‎‎‎‎‎‎‎</value>
          </Data>
          <Data name="نطاق الأسعار">
            <value>من 180 فما فوق لالليلة</value>
          </Data>
          <Data name="التصنيف">
            <value>4 نجوم</value>
          </Data>
          <Data name="عدد الغرف">
            <value>شقق فندقية</value>
          </Data>
          <Data name="الخدمات">
            <value>يوفر شققاً فندقية مجهزة بأساسيات الإقامة المنزلية مثل الثلاجة والغسالة وأدوات المطبخ البسيطة.آراء النزلاء: يصف بعض الزوار المكان بأنه هادئ ونظيف ويتميز باختيار أنيق للأثاث.</value>
          </Data>
          <Data name="الوصف">
            <value>: أشار بعض النزلاء إلى عدم توفر خدمات غرف تقليدية أو وجبات إفطار صباحية ضمن الإقامة.</value>
          </Data>
